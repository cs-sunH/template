 constexpr std::size_t kMaxPlanEpochs = 64;
 constexpr std::uint64_t kMaxAdvanceEvents = 1000000;
 
+// Curved credit coordinates are dimensionless model units. For a positive
+// subunit buffer, the old absolute floor of one unit can exceed its entire
+// capacity and erase substantial physical service. Narrow only those guards
+// relative to the declared capacity; retain every original ordinary/legacy
+// tolerance expression and never enlarge a finite-buffer tolerance.
+template<class T>
+T credit_boundary_tolerance(const Epoch& epoch, std::size_t buffer, T original) {
+  const double capacity = epoch.credit_capacity[buffer];
+  if (!(capacity > 0.0 && capacity < 1.0)) return original;
+  const bool curved = std::any_of(epoch.activities.begin(), epoch.activities.end(),
+      [](const Activity& activity) { return !activity.credit_curve.empty(); });
+  if (!curved) return original;
+  return static_cast<T>(kCreditTolerance) * static_cast<T>(capacity);
+}
+
+template<class T>
+T credit_boundary_tolerance(const Execution& execution, std::size_t buffer, T original) {
+  if (execution.epoch >= execution.plan->epochs.size()) return original;
+  return credit_boundary_tolerance(execution.plan->epochs[execution.epoch], buffer, original);
+}
