+
+
+_SIMULATOR_BASE_KERNEL = Kernel
+
+
+class _SimulatorOnlyKernelLaunchFrame:
+    """Minimal launch frame for simulator kernels whose logical block rank exceeds TileLang's 3D grid."""
+
+    def __init__(self, block_count: int):
+        self.block_count = block_count
+
+    def __enter__(self):
+        return _normalize_bindings([tir.Var(f"sim_block_{index}", "int32") for index in range(self.block_count)])
+
+    def __exit__(self, exc_type, exc_value, traceback):
+        return False
+
+
+def _normalize_simulator_kernel_threads(threads, is_cpu: bool):
+    if not is_cpu and threads is None:
+        return (128, 1, 1)
+    if isinstance(threads, int):
+        return (threads, 1, 1)
+    if isinstance(threads, list):
+        return tuple(threads + [1] * (3 - len(threads)))
+    if isinstance(threads, tuple):
+        return tuple(list(threads) + [1] * (3 - len(threads)))
+    return None
+
+
+def _build_simulator_kernel_launch_frame(
+    blocks: tuple[int | tir.PrimExpr, ...],
+    threads: int | list[int] | tuple | None,
+    is_cpu: bool,
+    prelude: str | None,
+    core_list: list[int] | None,
+):
+    if blocks:
+        if len(blocks) > 3:
+            from .simulator.frame import get_simulator_frame_state
+
+            if get_simulator_frame_state().op_region_stack:
+                return _SimulatorOnlyKernelLaunchFrame(len(blocks))
+        return _SIMULATOR_BASE_KERNEL(
+            *blocks,
+            threads=threads,
+            is_cpu=is_cpu,
+            prelude=prelude,
+        )
+    if core_list is None:
+        raise ValueError("T.Kernel without block extents currently requires core_list.")
+    # Keep blockless MPMD kernels on the original KernelLaunchFrame path by using
+    # a synthetic single-iteration CPU-style frame. The simulator wrapper still
+    # records empty block_expressions and marks the region as blockless.
+    return _SIMULATOR_BASE_KERNEL(
+        1,
+        is_cpu=True,
+        prelude=prelude,
+    )
+
+
+def Kernel(
+    *blocks: int | tir.PrimExpr,
+    threads: int | list[int] | tuple | None = None,
+    is_cpu: bool = False,
+    prelude: str | None = None,
+    autotune: bool | None = None,
+    core_list: list[int] | None = None,
+):
+    kernel_launch_frame = _build_simulator_kernel_launch_frame(
+        blocks=tuple(blocks),
+        threads=threads,
+        is_cpu=is_cpu,
+        prelude=prelude,
+        core_list=core_list,
+    )
+    simulator_kernel_attrs = {}
+    if not blocks:
+        simulator_kernel_attrs["is_blockless"] = True
+    if is_cpu:
+        simulator_kernel_attrs["is_cpu"] = True
+    if prelude is not None:
+        simulator_kernel_attrs["prelude"] = prelude
+    if autotune is not None:
+        simulator_kernel_attrs["autotune"] = autotune
+    if core_list is not None:
+        simulator_kernel_attrs["core_list"] = list(core_list)
+
+    from .simulator.frame import wrap_kernel_launch_frame
+
+    return wrap_kernel_launch_frame(
+        kernel_launch_frame,
+        block_expressions=tuple(blocks),
+        thread_expressions=_normalize_simulator_kernel_threads(threads, is_cpu),
+        autotune_enabled=autotune,
+        core_list=core_list,
+        attrs=simulator_kernel_attrs,
+    )
+
+
+Kernel.__doc__ = _SIMULATOR_BASE_KERNEL.__doc__
