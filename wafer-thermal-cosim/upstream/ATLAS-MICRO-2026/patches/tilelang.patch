new file mode 100644
index 00000000..d62a7581
--- /dev/null
+++ b/tilelang/language/communication_op.py
@@ -0,0 +1,51 @@
+"""Communication operations exposed on the TileLang language surface."""
+
+from __future__ import annotations
+
+from tilelang._typing import BufferLikeType
+from tvm import tir
+
+from tilelang.language.simulator.frame import make_tensor_access, record_simulator_action
+from tilelang.utils.language import retrieve_shape, to_buffer_region
+
+
+def send(src_core, dst_core, buffer_like: BufferLikeType) -> tir.PrimExpr:
+    """Emit a simulator-oriented send placeholder over a buffer-like payload."""
+
+    extents = tuple(retrieve_shape(buffer_like))
+    record_simulator_action(
+        "noc_send",
+        input_accesses=[make_tensor_access(buffer_like, access_mode="read", extents=extents)],
+        attrs={
+            "src_core": src_core,
+            "dst_core": dst_core,
+        },
+    )
+    return tir.call_extern(
+        "handle",
+        "tl.simulator.send",
+        tir.convert(src_core),
+        tir.convert(dst_core),
+        to_buffer_region(buffer_like, access_type="r", extents=list(extents)),
+    )
+
+
+def recv(src_core, dst_core, buffer_like: BufferLikeType) -> tir.PrimExpr:
+    """Emit a simulator-oriented recv placeholder over a buffer-like payload."""
+
+    extents = tuple(retrieve_shape(buffer_like))
+    record_simulator_action(
+        "noc_recv",
+        output_accesses=[make_tensor_access(buffer_like, access_mode="write", extents=extents)],
+        attrs={
+            "src_core": src_core,
+            "dst_core": dst_core,
+        },
+    )
+    return tir.call_extern(
+        "handle",
+        "tl.simulator.recv",
+        tir.convert(src_core),
+        tir.convert(dst_core),
+        to_buffer_region(buffer_like, access_type="w", extents=list(extents)),
+    )
