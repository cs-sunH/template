diff --git a/tilelang/_optional_torch.py b/tilelang/_optional_torch.py
new file mode 100644
index 00000000..0d853fff
--- /dev/null
+++ b/tilelang/_optional_torch.py
@@ -0,0 +1,25 @@
+from __future__ import annotations
+
+from functools import lru_cache
+
+
+@lru_cache(maxsize=1)
+def get_torch():
+    try:
+        import torch
+    except ModuleNotFoundError:
+        return None
+    return torch
+
+
+def require_torch(feature: str):
+    torch = get_torch()
+    if torch is None:
+        raise RuntimeError(
+            f"{feature} requires PyTorch, but torch is not installed. "
+            "Install torch or use the ATLAS no-GPU simulator-only flow that avoids GPU runtime features."
+        )
+    return torch
+
+
+__all__ = ["get_torch", "require_torch"]
