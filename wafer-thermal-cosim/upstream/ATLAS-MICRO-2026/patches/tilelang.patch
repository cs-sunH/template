+    "sqrt": _tir_ir.sqrt,
+    "tan": _tir_ir.tan,
+    "tanh": _tir_ir.tanh,
+    "trunc": _tir_ir.trunc,
+}
+
+_NARY_SCALAR_OPS = {
+    "atan2": _tir_ir.atan2,
+    "bitwise_and": _tir_ir.bitwise_and,
+    "bitwise_or": _tir_ir.bitwise_or,
+    "bitwise_xor": _tir_ir.bitwise_xor,
+    "copysign": _tir_ir.copysign,
+    "ceildiv": _tir_ir.ceildiv,
+    "floordiv": _tir_ir.floordiv,
+    "floormod": _tir_ir.floormod,
+    "fmod": _tir_ir.fmod,
+    "hypot": _tir_ir.hypot,
+    "if_then_else": _tir_ir.if_then_else,
+    "ldexp": _tir_ir.ldexp,
+    "nextafter": _tir_ir.nextafter,
+    "pow": _tir_ir.pow,
+    "q_multiply_shift": _tir_ir.q_multiply_shift,
+    "q_multiply_shift_per_axis": _tir_ir.q_multiply_shift_per_axis,
+    "shift_left": _tir_ir.shift_left,
+    "shift_right": _tir_ir.shift_right,
+    "truncdiv": _tir_ir.truncdiv,
+    "truncmod": _tir_ir.truncmod,
+}
+
+
+def _is_buffer_like(value) -> bool:
+    return isinstance(value, (tir.Buffer, tir.BufferRegion, tir.BufferLoad))
+
+
+def _extract_static_int(expr) -> int | None:
+    if isinstance(expr, int):
+        return expr
+    if isinstance(expr, tir.IntImm):
+        return int(expr.value)
+    return None
+
+
+def _maybe_promote_leading_axis_vector(vector_shape: list, target_shape: list) -> list | None:
+    if len(vector_shape) != 1 or len(target_shape) <= 1:
+        return None
+    if prim_expr_equal(vector_shape[0], target_shape[0]):
+        return [vector_shape[0]] + [1] * (len(target_shape) - 1)
+    return None
+
+
+def _broadcast_shape_pair(lhs_shape: list, rhs_shape: list) -> tuple[list, list, list]:
+    lhs = list(lhs_shape)
+    rhs = list(rhs_shape)
+    lhs = _maybe_promote_leading_axis_vector(lhs, rhs) or lhs
+    rhs = _maybe_promote_leading_axis_vector(rhs, lhs) or rhs
+    rank = builtins.max(len(lhs), len(rhs))
+    lhs = [1] * (rank - len(lhs)) + lhs
+    rhs = [1] * (rank - len(rhs)) + rhs
+    result = []
+    lhs_legalized = []
+    rhs_legalized = []
+    for lhs_dim, rhs_dim in zip(lhs, rhs):
+        if prim_expr_equal(lhs_dim, rhs_dim):
+            result_dim = lhs_dim
+        elif prim_expr_equal(lhs_dim, 1):
+            result_dim = rhs_dim
+        elif prim_expr_equal(rhs_dim, 1):
+            result_dim = lhs_dim
+        else:
+            lhs_static = _extract_static_int(lhs_dim)
+            rhs_static = _extract_static_int(rhs_dim)
+            if lhs_static is not None and rhs_static is not None and lhs_static != rhs_static:
+                raise ValueError(f"Incompatible broadcast dimensions: {lhs_dim} and {rhs_dim}")
+            result_dim = tir.max(lhs_dim, rhs_dim)
+        result.append(result_dim)
+        lhs_legalized.append(result_dim if prim_expr_equal(lhs_dim, 1) else lhs_dim if prim_expr_equal(lhs_dim, result_dim) else result_dim)
+        rhs_legalized.append(result_dim if prim_expr_equal(rhs_dim, 1) else rhs_dim if prim_expr_equal(rhs_dim, result_dim) else result_dim)
+    return lhs_legalized, rhs_legalized, result
+
+
+def _broadcast_shapes(shapes: list[list]) -> tuple[list[list], list]:
+    if not shapes:
+        raise ValueError("At least one input shape is required")
+    result = list(shapes[0])
+    for shape in shapes[1:]:
+        _, _, result = _broadcast_shape_pair(result, list(shape))
+    legalized = []
+    for shape in shapes:
+        aligned_shape = [1] * (len(result) - len(shape)) + list(shape)
+        legalized_shape = []
+        for shape_dim, result_dim in zip(aligned_shape, result):
+            legalized_shape.append(result_dim if prim_expr_equal(shape_dim, 1) else shape_dim if prim_expr_equal(shape_dim, result_dim) else result_dim)
+        legalized.append(legalized_shape)
+    return legalized, result
+
+
+def _assert_exact_shape_match(input_shape: list, output_shape: list, op_name: str) -> None:
+    if len(input_shape) != len(output_shape):
+        raise ValueError(f"{op_name} expects identical input/output ranks, got {input_shape} and {output_shape}")
+    for input_dim, output_dim in zip(input_shape, output_shape):
+        if not prim_expr_equal(input_dim, output_dim):
+            raise ValueError(f"{op_name} expects identical input/output shapes, got {input_shape} and {output_shape}")
+
+
+def _assert_output_shape(output_shape: list, expected_shape: list, op_name: str) -> None:
+    if len(output_shape) != len(expected_shape):
+        raise ValueError(f"{op_name} output rank mismatch, expected {expected_shape}, got {output_shape}")
+    for output_dim, expected_dim in zip(output_shape, expected_shape):
+        if not prim_expr_equal(output_dim, expected_dim):
+            raise ValueError(f"{op_name} output shape mismatch, expected {expected_shape}, got {output_shape}")
+
+
+def _make_region_argument(buffer_like: BufferLikeType, extents: list, access_type: str) -> tir.PrimExpr:
+    return to_buffer_region(buffer_like, access_type=access_type, extents=list(extents))
+
+
+def _emit_process_style_call(op_name: str, input_regions: list[tir.PrimExpr], output_region: tir.PrimExpr) -> tir.PrimExpr:
+    return tir.call_extern("handle", "tl.simulator.elementwise", op_name, *input_regions, output_region)
+
+
+def _record_vector_compute(op_name: str, inputs: list[BufferLikeType], output: BufferLikeType, input_shapes: list[list], output_shape: list) -> None:
+    record_simulator_action(
+        "vector_compute",
+        input_accesses=[
+            make_tensor_access(value, access_mode="read", extents=tuple(extents))
+            for value, extents in zip(inputs, input_shapes)
+        ],
+        output_accesses=[make_tensor_access(output, access_mode="readwrite", extents=tuple(output_shape))],
+        attrs={
+            "op_name": op_name,
+        },
+    )
+
+
+def _dispatch_unary_process_or_scalar(op_name: str, scalar_func: Callable):
+    def wrapper(value, out=None):
+        if out is not None and _is_buffer_like(value) and _is_buffer_like(out):
+            input_shape = list(retrieve_shape(value))
+            output_shape = list(retrieve_shape(out))
+            _assert_exact_shape_match(input_shape, output_shape, op_name)
+            _record_vector_compute(op_name, [value], out, [input_shape], output_shape)
+            return _emit_process_style_call(
+                op_name,
+                [_make_region_argument(value, input_shape, access_type="r")],
+                _make_region_argument(out, output_shape, access_type="w"),
+            )
+        return scalar_func(value)
+
+    wrapper.__name__ = op_name
+    return wrapper
+
+
+def _dispatch_nary_process_or_scalar(op_name: str, scalar_func: Callable):
+    def wrapper(*args):
+        if len(args) >= 2 and _is_buffer_like(args[-1]) and all(_is_buffer_like(value) for value in args[:-1]):
+            inputs = list(args[:-1])
+            output = args[-1]
+            input_shapes = [list(retrieve_shape(value)) for value in inputs]
+            legalized_input_shapes, output_shape = _broadcast_shapes(input_shapes)
+            _assert_output_shape(list(retrieve_shape(output)), output_shape, op_name)
+            _record_vector_compute(op_name, inputs, output, legalized_input_shapes, output_shape)
+            input_regions = [
+                _make_region_argument(value, extents, access_type="r")
+                for value, extents in zip(inputs, legalized_input_shapes)
+            ]
+            output_region = _make_region_argument(output, output_shape, access_type="w")
+            return _emit_process_style_call(op_name, input_regions, output_region)
+        return scalar_func(*args)
+
+    wrapper.__name__ = op_name
+    return wrapper
+
+
+def add(lhs, rhs, out=None):
+    if out is not None and _is_buffer_like(lhs) and _is_buffer_like(rhs) and _is_buffer_like(out):
+        return _dispatch_nary_process_or_scalar("add", lambda a, b: a + b)(lhs, rhs, out)
+    return lhs + rhs
+
+
+def sub(lhs, rhs, out=None):
+    if out is not None and _is_buffer_like(lhs) and _is_buffer_like(rhs) and _is_buffer_like(out):
+        return _dispatch_nary_process_or_scalar("sub", lambda a, b: a - b)(lhs, rhs, out)
+    return lhs - rhs
+
+
+def mul(lhs, rhs, out=None):
+    if out is not None and _is_buffer_like(lhs) and _is_buffer_like(rhs) and _is_buffer_like(out):
+        return _dispatch_nary_process_or_scalar("mul", lambda a, b: a * b)(lhs, rhs, out)
+    return lhs * rhs
+
+
+def div(lhs, rhs, out=None):
+    if out is not None and _is_buffer_like(lhs) and _is_buffer_like(rhs) and _is_buffer_like(out):
+        return _dispatch_nary_process_or_scalar("div", lambda a, b: a / b)(lhs, rhs, out)
+    return lhs / rhs
+
+
+def max(lhs, rhs, out=None):  # pylint: disable=redefined-builtin
+    if out is not None and _is_buffer_like(lhs) and _is_buffer_like(rhs) and _is_buffer_like(out):
+        return _dispatch_nary_process_or_scalar("max", tir.max)(lhs, rhs, out)
+    return tir.max(lhs, rhs)
+
+
+def min(lhs, rhs, out=None):  # pylint: disable=redefined-builtin
+    if out is not None and _is_buffer_like(lhs) and _is_buffer_like(rhs) and _is_buffer_like(out):
+        return _dispatch_nary_process_or_scalar("min", tir.min)(lhs, rhs, out)
+    return tir.min(lhs, rhs)
+
+
+def cast(value, dtype_or_out, out=None):
+    if out is None and _is_buffer_like(value) and _is_buffer_like(dtype_or_out):
+        input_shape = list(retrieve_shape(value))
+        output_shape = list(retrieve_shape(dtype_or_out))
+        _assert_exact_shape_match(input_shape, output_shape, "cast")
+        _record_vector_compute("cast", [value], dtype_or_out, [input_shape], output_shape)
+        return _emit_process_style_call(
+            "cast",
+            [_make_region_argument(value, input_shape, access_type="r")],
+            _make_region_argument(dtype_or_out, output_shape, access_type="w"),
+        )
+    return tir.cast(value, dtype_or_out)
+
+
+def reinterpret(value, dtype_or_out, out=None):
+    if out is None and _is_buffer_like(value) and _is_buffer_like(dtype_or_out):
+        input_shape = list(retrieve_shape(value))
+        output_shape = list(retrieve_shape(dtype_or_out))
+        _assert_exact_shape_match(input_shape, output_shape, "reinterpret")
+        _record_vector_compute("reinterpret", [value], dtype_or_out, [input_shape], output_shape)
+        return _emit_process_style_call(
+            "reinterpret",
+            [_make_region_argument(value, input_shape, access_type="r")],
+            _make_region_argument(dtype_or_out, output_shape, access_type="w"),
+        )
+    return _tir_ir.reinterpret(value, dtype_or_out)
+
+
+for _op_name, _scalar_func in _UNARY_SCALAR_OPS.items():
+    globals()[_op_name] = _dispatch_unary_process_or_scalar(_op_name, _scalar_func)
+
+for _op_name, _scalar_func in _NARY_SCALAR_OPS.items():
+    globals()[_op_name] = _dispatch_nary_process_or_scalar(_op_name, _scalar_func)
+
+
+__all__ = [
+    "add",
+    "sub",
+    "mul",
+    "div",
+    "max",
+    "min",
+    "cast",
+    "reinterpret",
+    *_UNARY_SCALAR_OPS.keys(),
+    *_NARY_SCALAR_OPS.keys(),
+]
