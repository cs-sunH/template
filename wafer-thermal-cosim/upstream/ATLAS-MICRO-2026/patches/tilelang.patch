index 00000000..7a387f49
--- /dev/null
+++ b/tilelang/language/simulator/common/expressions.py
@@ -0,0 +1,127 @@
+"""Static expression evaluation helpers shared by simulator materializers."""
+
+from __future__ import annotations
+
+from typing import Any
+
+from tvm import arith, tir
+from tvm.tir.stmt_functor import ir_transform, post_order_visit, substitute
+
+
+def substitute_and_simplify(expr: Any, env: dict[str, int]) -> Any:
+    """Evaluate the static portion of a TIR expression under the current loop/core env."""
+    if not isinstance(expr, tir.PrimExpr):
+        return expr
+    var_map: dict[tir.Var, tir.IntImm] = {}
+
+    def visitor(node):
+        if isinstance(node, tir.Var) and node.name in env and node not in var_map:
+            var_map[node] = tir.IntImm(node.dtype, int(env[node.name]))
+
+    post_order_visit(expr, visitor)
+    if not var_map:
+        return expr
+    return arith.Analyzer().simplify(substitute(expr, var_map))
+
+
+def evaluate_static_int(expr: Any, env: dict[str, int], *, description: str) -> int:
+    """Resolve a scalar expression to a static integer."""
+    value = substitute_and_simplify(expr, env)
+    if isinstance(value, bool):
+        raise ValueError(f"{description} must resolve to a static integer, but got bool.")
+    if isinstance(value, int):
+        return value
+    if isinstance(value, tir.IntImm):
+        return int(value.value)
+    raise ValueError(f"{description} must resolve to a static integer, but got {value!r}.")
+
+
+def evaluate_static_bool(expr: Any, env: dict[str, int], *, description: str) -> bool:
+    """Resolve a branch predicate to a static boolean under the current env."""
+    value = substitute_and_simplify(expr, env)
+    if isinstance(value, bool):
+        return value
+    if isinstance(value, tir.IntImm):
+        return bool(value.value)
+    if isinstance(value, tir.FloatImm):
+        return bool(value.value)
+    analyzer = arith.Analyzer()
+    zero = tir.IntImm("int32", 0)
+    if analyzer.can_prove(value):
+        return True
+    if analyzer.can_prove(value == zero):
+        return False
+    raise ValueError(f"{description} must resolve to a static predicate, but got {value!r}.")
+
+
+def extract_ceildiv_operands(expr: Any) -> tuple[Any, Any] | None:
+    """Recover operands from TVM's lowered `ceildiv(lhs, rhs)` expression shape."""
+    if not isinstance(expr, tir.FloorDiv):
+        return None
+    numerator = expr.a
+    denominator = expr.b
+    if not isinstance(numerator, tir.Sub):
+        return None
+    subtrahend = numerator.b
+    if not isinstance(subtrahend, tir.IntImm) or int(subtrahend.value) != 1:
+        return None
+    add_expr = numerator.a
+    if not isinstance(add_expr, tir.Add):
+        return None
+    if tir.analysis.expr_deep_equal(add_expr.b, denominator):
+        return add_expr.a, denominator
+    if tir.analysis.expr_deep_equal(add_expr.a, denominator):
+        return add_expr.b, denominator
+    return None
+
+
+def collect_ceildiv_operands(expr: Any) -> list[tuple[Any, Any]]:
+    if not isinstance(expr, tir.PrimExpr):
+        return []
+    operands: list[tuple[Any, Any]] = []
+
+    def visitor(node):
+        ceildiv_operands = extract_ceildiv_operands(node)
+        if ceildiv_operands is not None:
+            operands.append(ceildiv_operands)
+
+    post_order_visit(expr, visitor)
+    return operands
+
+
+def replace_ceildiv_with_static_extents(expr: Any, rhs_values: list[int], env: dict[str, int]) -> Any:
+    if not rhs_values or not isinstance(expr, tir.PrimExpr):
+        return expr
+    next_index = 0
+
+    def postorder(node):
+        nonlocal next_index
+        ceildiv_operands = extract_ceildiv_operands(node)
+        if ceildiv_operands is None:
+            return node
+        if next_index >= len(rhs_values):
+            raise ValueError("General autotune candidate did not provide enough rhs values for ceildiv replacement.")
+        lhs_expr, _ = ceildiv_operands
+        candidate_rhs = int(rhs_values[next_index])
+        next_index += 1
+        lhs_value = evaluate_static_int(lhs_expr, env, description="General autotune ceildiv lhs")
+        if candidate_rhs <= 0 or lhs_value % candidate_rhs != 0:
+            raise ValueError(
+                f"General autotune rhs {candidate_rhs} must be a positive divisor of lhs {lhs_value}."
+            )
+        return tir.IntImm(node.dtype, lhs_value // candidate_rhs)
+
+    replaced_expr = ir_transform(expr, None, postorder, ["tir.FloorDiv"])
+    if next_index != len(rhs_values):
+        raise ValueError("General autotune candidate provided unused rhs values for ceildiv replacement.")
+    return replaced_expr
+
+
+__all__ = [
+    "collect_ceildiv_operands",
+    "evaluate_static_bool",
+    "evaluate_static_int",
+    "extract_ceildiv_operands",
+    "replace_ceildiv_with_static_extents",
+    "substitute_and_simplify",
+]
