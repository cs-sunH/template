new file mode 100644
index 00000000..fa83335b
--- /dev/null
+++ b/tilelang/language/eager/symbolic_container.py
@@ -0,0 +1,161 @@
+from __future__ import annotations
+
+import builtins
+from dataclasses import dataclass
+from typing import Any
+
+from tvm import tir
+from tvm.tir import FloatImm, IntImm, PrimExpr, StringImm
+
+
+def _extract_concrete_index(index: Any) -> int | None:
+    if isinstance(index, bool):
+        return int(index)
+    if isinstance(index, int):
+        return index
+    if isinstance(index, IntImm):
+        return int(index.value)
+    return None
+
+
+def _is_symbolic_index(index: Any) -> bool:
+    return _extract_concrete_index(index) is None and isinstance(index, PrimExpr)
+
+
+def _container_items(node: Any) -> list[tuple[int, Any]]:
+    if isinstance(node, (list, tuple)):
+        return list(enumerate(node))
+    if isinstance(node, dict):
+        if not all(isinstance(key, int) for key in node):
+            raise TypeError(f"Only integer-key dicts are supported for symbolic indexing, got keys={list(node.keys())}")
+        return sorted(node.items())
+    raise TypeError(f"Unsupported symbolic container node: {type(node)}")
+
+
+def _container_length(node: Any) -> int:
+    if isinstance(node, (list, tuple)):
+        return builtins.len(node)
+    if isinstance(node, dict) and all(isinstance(key, int) for key in node):
+        return builtins.len(node)
+    raise TypeError(f"Object of type `{type(node)}` does not have a symbolic length")
+
+
+def _is_container_node(node: Any) -> bool:
+    return isinstance(node, (list, tuple)) or (isinstance(node, dict) and all(isinstance(key, int) for key in node))
+
+
+def _to_tir_scalar(value: Any) -> Any:
+    if isinstance(value, (PrimExpr, IntImm, FloatImm, StringImm)):
+        return value
+    if isinstance(value, bool):
+        return tir.const(value, "bool")
+    if isinstance(value, int):
+        return tir.IntImm("int32", value)
+    if isinstance(value, float):
+        return tir.FloatImm("float32", value)
+    return value
+
+
+def _selector_key_expr(selector: PrimExpr, key: int):
+    selector_dtype = getattr(selector, "dtype", "int32")
+    return tir.const(key, selector_dtype)
+
+
+def _select_symbolic_scalar(selector: PrimExpr, branches: list[tuple[int, Any]]) -> Any:
+    if not branches:
+        return tir.IntImm("int32", 0)
+    selected_value = _to_tir_scalar(branches[-1][1])
+    for branch_key, branch_value in reversed(branches[:-1]):
+        selected_value = tir.if_then_else(selector == _selector_key_expr(selector, branch_key), _to_tir_scalar(branch_value), selected_value)
+    return selected_value
+
+
+@dataclass(slots=True)
+class SymbolicContainerView:
+    data: Any
+    selectors: tuple[Any, ...] = ()
+
+    def _candidate_subtrees(self, node: Any, selectors: tuple[Any, ...]) -> list[Any]:
+        if not selectors:
+            return [node]
+        selector = selectors[0]
+        remaining_selectors = selectors[1:]
+        concrete_index = _extract_concrete_index(selector)
+        if concrete_index is not None:
+            return self._candidate_subtrees(_container_items(node)[concrete_index][1], remaining_selectors)
+        candidate_subtrees: list[Any] = []
+        for _, child in _container_items(node):
+            candidate_subtrees.extend(self._candidate_subtrees(child, remaining_selectors))
+        return candidate_subtrees
+
+    def _resolves_to_scalar(self, selectors: tuple[Any, ...]) -> bool:
+        return all(not _is_container_node(candidate) for candidate in self._candidate_subtrees(self.data, selectors))
+
+    def _eval_scalar(self, node: Any, selectors: tuple[Any, ...]) -> Any:
+        if not selectors:
+            return _to_tir_scalar(node)
+        selector = selectors[0]
+        remaining_selectors = selectors[1:]
+        concrete_index = _extract_concrete_index(selector)
+        if concrete_index is not None:
+            return self._eval_scalar(_container_items(node)[concrete_index][1], remaining_selectors)
+        if not _is_symbolic_index(selector):
+            raise TypeError(f"Unsupported selector `{selector}` of type `{type(selector)}` for symbolic container access")
+        branches = [(branch_key, self._eval_scalar(child, remaining_selectors)) for branch_key, child in _container_items(node)]
+        return _select_symbolic_scalar(selector, branches)
+
+    def _eval_length(self, node: Any, selectors: tuple[Any, ...]) -> Any:
+        if not selectors:
+            return _to_tir_scalar(_container_length(node))
+        selector = selectors[0]
+        remaining_selectors = selectors[1:]
+        concrete_index = _extract_concrete_index(selector)
+        if concrete_index is not None:
+            return self._eval_length(_container_items(node)[concrete_index][1], remaining_selectors)
+        if not _is_symbolic_index(selector):
+            raise TypeError(f"Unsupported selector `{selector}` of type `{type(selector)}` for symbolic length access")
+        branches = [(branch_key, self._eval_length(child, remaining_selectors)) for branch_key, child in _container_items(node)]
+        return _select_symbolic_scalar(selector, branches)
+
+    def _materialize_concrete_subtree(self) -> Any:
+        subtree = self.data
+        for selector in self.selectors:
+            concrete_index = _extract_concrete_index(selector)
+            if concrete_index is None:
+                raise TypeError("Cannot materialize a Python subtree from symbolic selectors")
+            subtree = _container_items(subtree)[concrete_index][1]
+        return subtree
+
+    def __getitem__(self, index: Any):
+        if isinstance(index, slice):
+            subtree = self._materialize_concrete_subtree()
+            sliced_subtree = subtree[index]
+            return wrap_symbolic_container(sliced_subtree)
+        next_selectors = self.selectors + (index,)
+        if self._resolves_to_scalar(next_selectors):
+            return self._eval_scalar(self.data, next_selectors)
+        return SymbolicContainerView(self.data, selectors=next_selectors)
+
+    def __iter__(self):
+        subtree = self._materialize_concrete_subtree()
+        return builtins.iter(subtree)
+
+    def symbolic_len(self):
+        candidate_subtrees = self._candidate_subtrees(self.data, self.selectors)
+        if any(not _is_container_node(candidate) for candidate in candidate_subtrees):
+            raise TypeError(f"Cannot take symbolic length from scalar subtree candidates `{candidate_subtrees}`")
+        return self._eval_length(self.data, self.selectors)
+
+
+def wrap_symbolic_container(value: Any) -> Any:
+    if isinstance(value, SymbolicContainerView):
+        return value
+    if isinstance(value, (list, tuple)) or (isinstance(value, dict) and all(isinstance(key, int) for key in value)):
+        return SymbolicContainerView(value)
+    return value
+
+
+def symbolic_len(value: Any) -> Any:
+    if isinstance(value, SymbolicContainerView):
+        return value.symbolic_len()
+    return builtins.len(value)
