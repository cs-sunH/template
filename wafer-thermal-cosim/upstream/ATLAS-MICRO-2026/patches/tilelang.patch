+"""Top-level simulator extraction dispatch for cloud and edge systems."""
+
+from __future__ import annotations
+
+from .common.system import is_edge_system_config
+from .cloud.extract import extract_cloud_simulator_outputs
+from .edge.extract import extract_edge_simulator_outputs
+
+
+def extract_simulator_outputs(
+    snapshot,
+    *,
+    system_config,
+    operator_dict,
+    dtype,
+    intermediate_result_dir,
+    gemm_tiling_cache_dir,
+):
+    if is_edge_system_config(system_config):
+        return extract_edge_simulator_outputs(
+            snapshot,
+            system_config=system_config,
+            operator_dict=operator_dict,
+            dtype=dtype,
+            intermediate_result_dir=intermediate_result_dir,
+            gemm_tiling_cache_dir=gemm_tiling_cache_dir,
+        )
+    return extract_cloud_simulator_outputs(
+        snapshot,
+        system_config=system_config,
+        operator_dict=operator_dict,
+        dtype=dtype,
+        intermediate_result_dir=intermediate_result_dir,
+        gemm_tiling_cache_dir=gemm_tiling_cache_dir,
+    )
+
+
+__all__ = ["extract_simulator_outputs"]
diff --git a/tilelang/language/simulator/frame.py b/tilelang/language/simulator/frame.py
new file mode 100644
index 00000000..4ea39acd
--- /dev/null
+++ b/tilelang/language/simulator/frame.py
@@ -0,0 +1,1025 @@
+from __future__ import annotations
+
+from dataclasses import dataclass, field
+import math
+import re
+from typing import Any
+
+from tvm import DataType, arith, ir, tir
+from tvm.tir.stmt_functor import post_order_visit, substitute
+
+from tilelang.jit.exceptions import JITNoBuilderError
+
+from .ir import (
+    CoreArrayContext,
+    KernelRegion,
+    LoopRegion,
+    OpAction,
+    OpRegion,
+    SimulatorMetadataSnapshot,
+    TensorAccess,
+    TensorDecl,
+)
+
+
+_SIMULATOR_FRAME_STATE_ATTR = "_simulator_frame_state"
+
+
+@dataclass(slots=True)
+class SimulatorFrameState:
+    core_array_contexts: list[CoreArrayContext] = field(default_factory=list)
+    core_array_stack: list[CoreArrayContext] = field(default_factory=list)
+    op_region_stack: list[OpRegion] = field(default_factory=list)
+    kernel_region_stack: list[KernelRegion] = field(default_factory=list)
+    loop_region_stack: list[LoopRegion] = field(default_factory=list)
+    active_conditions: list[Any] = field(default_factory=list)
+    tensor_declarations: dict[str, TensorDecl] = field(default_factory=dict)
+    ceildiv_expression_metadata: dict[int, dict[str, Any]] = field(default_factory=dict)
+    next_tensor_access_id: int = 0
+
+
+# ---------------------------------------------------------------------------
+# Builder-local state access
+# ---------------------------------------------------------------------------
+
+def _get_current_builder():
+    from tilelang.language.eager.builder import Builder
+
+    builder = Builder.current()
+    if builder is None:
+        raise JITNoBuilderError(
+            "Simulator-oriented with frames can only be used inside @tilelang.jit or @T.prim_func context."
+        )
+    return builder
+
+
+def get_simulator_frame_state():
+    builder = _get_current_builder()
+    frame_state = getattr(builder, _SIMULATOR_FRAME_STATE_ATTR, None)
+    if frame_state is None:
+        frame_state = SimulatorFrameState()
+        setattr(builder, _SIMULATOR_FRAME_STATE_ATTR, frame_state)
+    return frame_state
+
+
+# ---------------------------------------------------------------------------
+# Snapshot export helpers
+# ---------------------------------------------------------------------------
+
+def _clone_simulator_metadata_value(value: Any):
+    if isinstance(value, dict):
+        return {key: _clone_simulator_metadata_value(item_value) for key, item_value in value.items()}
+    if isinstance(value, list):
+        return [_clone_simulator_metadata_value(item_value) for item_value in value]
+    if isinstance(value, tuple):
+        return tuple(_clone_simulator_metadata_value(item_value) for item_value in value)
+    return value
+
+
+def _resolve_let_bound_prim_expr(expr: Any):
+    from tilelang.language.frame import get_let_value, has_let_value
+
+    if isinstance(expr, tir.Var) and has_let_value(expr):
+        return _resolve_simulator_capture_value(get_let_value(expr))
+    if not isinstance(expr, tir.PrimExpr):
+        return expr
+
+    var_map = {}
+    frame_state = get_simulator_frame_state()
+    current_op_region = frame_state.op_region_stack[-1] if frame_state.op_region_stack else None
+    core_identifier_name = None if current_op_region is None else current_op_region.attrs.get("core_identifier")
+
+    def visitor(node):
+        if not isinstance(node, tir.Var) or node in var_map:
+            return
+        if node.name == "core_id" and core_identifier_name is not None and core_identifier_name != "core_id":
+            var_map[node] = tir.Var(core_identifier_name, node.dtype)
+            return
+        if not has_let_value(node):
+            return
+        bound_value = get_let_value(node)
+        if isinstance(bound_value, tir.BufferRegion):
+            return
+        resolved_bound_value = _resolve_simulator_capture_value(bound_value)
+        if isinstance(resolved_bound_value, tir.PrimExpr):
+            var_map[node] = resolved_bound_value
+
+    post_order_visit(expr, visitor)
+    if not var_map:
+        return expr
+    return arith.Analyzer().simplify(substitute(expr, var_map))
+
+
+def _resolve_simulator_capture_value(value: Any):
+    if isinstance(value, dict):
+        return {key: _resolve_simulator_capture_value(item_value) for key, item_value in value.items()}
+    if isinstance(value, list):
+        return [_resolve_simulator_capture_value(item_value) for item_value in value]
+    if isinstance(value, tuple):
+        return tuple(_resolve_simulator_capture_value(item_value) for item_value in value)
+    if isinstance(value, tir.BufferRegion):
+        return tir.BufferRegion(
+            value.buffer,
+            [
+                ir.Range.from_min_extent(
+                    _resolve_let_bound_prim_expr(axis_range.min),
+                    _resolve_let_bound_prim_expr(axis_range.extent),
+                )
+                for axis_range in value.region
+            ],
+        )
+    if isinstance(value, tir.BufferLoad):
+        return tir.BufferLoad(
+            value.buffer,
+            [_resolve_let_bound_prim_expr(index_expr) for index_expr in value.indices],
+        )
+    if isinstance(value, tir.PrimExpr):
+        return _resolve_let_bound_prim_expr(value)
+    return value
+
+
+def record_ceildiv_expression(result: Any, lhs: Any, rhs: Any) -> None:
+    try:
+        frame_state = get_simulator_frame_state()
+    except JITNoBuilderError:
+        return
+    frame_state.ceildiv_expression_metadata[id(result)] = {
+        "lhs": _resolve_simulator_capture_value(lhs),
+        "rhs": _resolve_simulator_capture_value(rhs),
+    }
+
+
+def _clone_tensor_declaration(tensor_declaration: TensorDecl) -> TensorDecl:
+    return TensorDecl(
+        name=tensor_declaration.name,
+        from_parameter=tensor_declaration.from_parameter,
+        shape=tensor_declaration.shape,
+        strides=tensor_declaration.strides,
+        dtype=tensor_declaration.dtype,
+        allow_cross_region_reuse=tensor_declaration.allow_cross_region_reuse,
+        declaration_site=tensor_declaration.declaration_site,
+        attrs=_clone_simulator_metadata_value(tensor_declaration.attrs),
+    )
+
+
+def _clone_tensor_access(tensor_access: TensorAccess) -> TensorAccess:
+    return TensorAccess(
+        tensor_name=tensor_access.tensor_name,
+        access_mode=tensor_access.access_mode,
+        index_expressions=tensor_access.index_expressions,
+        slice_shape=tensor_access.slice_shape,
+        slice_strides=tensor_access.slice_strides,
+        byte_count=tensor_access.byte_count,
+        attrs=_clone_simulator_metadata_value(tensor_access.attrs),
+    )
+
+
+def _clone_op_action(op_action: OpAction) -> OpAction:
+    return OpAction(
+        action_kind=op_action.action_kind,
+        input_accesses=[_clone_tensor_access(tensor_access) for tensor_access in op_action.input_accesses],
+        output_accesses=[_clone_tensor_access(tensor_access) for tensor_access in op_action.output_accesses],
+        attrs=_clone_simulator_metadata_value(op_action.attrs),
+    )
+
+
+def _clone_loop_region(loop_region: LoopRegion) -> LoopRegion:
+    return LoopRegion(
+        loop_variable=loop_region.loop_variable,
+        extent_expression=loop_region.extent_expression,
+        loop_kind=loop_region.loop_kind,
+        child_loops=[_clone_loop_region(child_loop) for child_loop in loop_region.child_loops],
+        actions=[_clone_op_action(op_action) for op_action in loop_region.actions],
+        body_sequence=_clone_simulator_metadata_value(loop_region.body_sequence),
+        attrs=_clone_simulator_metadata_value(loop_region.attrs),
+    )
+
+
+def _clone_kernel_region(kernel_region: KernelRegion) -> KernelRegion:
+    return KernelRegion(
+        block_expressions=kernel_region.block_expressions,
+        thread_expressions=kernel_region.thread_expressions,
+        autotune_enabled=kernel_region.autotune_enabled,
+        core_list=kernel_region.core_list,
+        bound_symbols=kernel_region.bound_symbols,
+        child_loops=[_clone_loop_region(child_loop) for child_loop in kernel_region.child_loops],
+        actions=[_clone_op_action(op_action) for op_action in kernel_region.actions],
+        body_sequence=_clone_simulator_metadata_value(kernel_region.body_sequence),
+        attrs=_clone_simulator_metadata_value(kernel_region.attrs),
+    )
+
+
+def _clone_op_region(op_region: OpRegion) -> OpRegion:
+    return OpRegion(
+        name=op_region.name,
+        region_kind=op_region.region_kind,
+        op_category=op_region.op_category,
+        region_kwargs=_clone_simulator_metadata_value(op_region.region_kwargs),
+        kernel_regions=[_clone_kernel_region(kernel_region) for kernel_region in op_region.kernel_regions],
+        attrs=_clone_simulator_metadata_value(op_region.attrs),
+    )
+
+
+def _clone_core_array_context(
+    core_array_context: CoreArrayContext,
+    tensor_clones: dict[str, TensorDecl],
+) -> CoreArrayContext:
+    return CoreArrayContext(
+        core_array_shape=core_array_context.core_array_shape,
+        global_kwargs=_clone_simulator_metadata_value(core_array_context.global_kwargs),
+        tensors={name: tensor_clones[name] for name in core_array_context.tensors},
+        op_regions=[_clone_op_region(op_region) for op_region in core_array_context.op_regions],
+        source_name=core_array_context.source_name,
+        attrs=_clone_simulator_metadata_value(core_array_context.attrs),
+    )
+
+
+def export_simulator_metadata_snapshot(builder=None) -> SimulatorMetadataSnapshot | None:
+    if builder is None:
+        builder = _get_current_builder()
+    frame_state = getattr(builder, _SIMULATOR_FRAME_STATE_ATTR, None)
+    if frame_state is None:
+        return None
+    tensor_clones = {
+        name: _clone_tensor_declaration(tensor_declaration) for name, tensor_declaration in frame_state.tensor_declarations.items()
+    }
+    return SimulatorMetadataSnapshot(
+        core_array_contexts=[
+            _clone_core_array_context(core_array_context, tensor_clones) for core_array_context in frame_state.core_array_contexts
+        ],
+        tensor_declarations=tensor_clones,
+        attrs={
+            "next_tensor_access_id": frame_state.next_tensor_access_id,
+        },
+    )
+
+
+def attach_simulator_metadata_snapshot(target, builder) -> SimulatorMetadataSnapshot | None:
+    snapshot = export_simulator_metadata_snapshot(builder)
+    if snapshot is None:
+        return None
+    target.simulator_metadata_snapshot = snapshot
+    target.simulator_extraction_result = snapshot.extraction_result
+    return snapshot
+
+
+# ---------------------------------------------------------------------------
+# Tensor declaration and parameter-reference tracking
+# ---------------------------------------------------------------------------
+
+
+def register_parameter_tensor_declaration(name: str) -> TensorDecl:
+    frame_state = get_simulator_frame_state()
+    tensor_declaration = frame_state.tensor_declarations.get(name)
+    if tensor_declaration is None:
+        tensor_declaration = TensorDecl(
+            name=name,
+            from_parameter=True,
+            allow_cross_region_reuse=True,
+            declaration_site="prim_func_parameter",
+        )
+        frame_state.tensor_declarations[name] = tensor_declaration
+    for core_array_context in frame_state.core_array_contexts:
+        if tensor_declaration.name not in core_array_context.tensors:
+            core_array_context.register_tensor(tensor_declaration)
+    return tensor_declaration
+
+
+def register_parameter_tensor_buffer(name: str, tensor_buffer) -> TensorDecl:
+    tensor_declaration = register_parameter_tensor_declaration(name)
+    if not tensor_declaration.has_layout:
+        tensor_declaration.shape = tuple(tensor_buffer.shape)
+        tensor_declaration.strides = None if tensor_buffer.strides is None else tuple(tensor_buffer.strides)
+        tensor_declaration.dtype = tensor_buffer.dtype
+        tensor_declaration.attrs["scope"] = tensor_buffer.scope()
+        tensor_declaration.attrs["declared_in_parameter"] = True
+    return tensor_declaration
+
+
+def get_tensor_declaration(name: str) -> TensorDecl | None:
+    frame_state = get_simulator_frame_state()
+    return frame_state.tensor_declarations.get(name)
+
+
+# ---------------------------------------------------------------------------
+# Loop / kernel action capture
+# ---------------------------------------------------------------------------
+
+def begin_loop_region(
+    *,
+    extent_expression: Any,
+    loop_kind: str,
+    attrs: dict[str, Any] | None = None,
+) -> LoopRegion | None:
+    frame_state = get_simulator_frame_state()
+    if not frame_state.kernel_region_stack:
+        return None
+    loop_region = LoopRegion(
+        extent_expression=_resolve_simulator_capture_value(extent_expression),
+        loop_kind=loop_kind,
+        attrs=_resolve_simulator_capture_value(dict(attrs or {})),
+    )
+    if frame_state.loop_region_stack:
+        parent_loop = frame_state.loop_region_stack[-1]
+        parent_loop.child_loops.append(loop_region)
+        parent_loop.body_sequence.append(("loop", len(parent_loop.child_loops) - 1))
+    else:
+        parent_kernel = frame_state.kernel_region_stack[-1]
+        parent_kernel.child_loops.append(loop_region)
+        parent_kernel.body_sequence.append(("loop", len(parent_kernel.child_loops) - 1))
+    frame_state.loop_region_stack.append(loop_region)
+    return loop_region
+
+
+def end_loop_region(loop_region: LoopRegion | None) -> None:
+    if loop_region is None:
+        return
+    frame_state = get_simulator_frame_state()
+    if frame_state.loop_region_stack and frame_state.loop_region_stack[-1] is loop_region:
+        frame_state.loop_region_stack.pop()
+
+
+def bind_loop_region_variable(loop_name: str, bound_expr: Any) -> None:
+    frame_state = get_simulator_frame_state()
+    if not frame_state.loop_region_stack or not loop_name or loop_name == "_":
+        return
+    current_loop_region = frame_state.loop_region_stack[-1]
+    if current_loop_region.loop_variable is None:
+        current_loop_region.loop_variable = loop_name
+        current_loop_region.attrs["bound_expr"] = _resolve_simulator_capture_value(bound_expr)
+
+
+def record_simulator_action(
+    action_kind: str,
+    *,
+    input_accesses: list[TensorAccess] | None = None,
+    output_accesses: list[TensorAccess] | None = None,
+    attrs: dict[str, Any] | None = None,
+) -> None:
+    frame_state = get_simulator_frame_state()
+    if not frame_state.kernel_region_stack:
+        return
+    op_action = OpAction(
+        action_kind=action_kind,
+        input_accesses=list(input_accesses or []),
+        output_accesses=list(output_accesses or []),
+        attrs=_resolve_simulator_capture_value(dict(attrs or {})),
+    )
+    if frame_state.active_conditions:
+        op_action.attrs["conditions"] = tuple(_resolve_simulator_capture_value(condition) for condition in frame_state.active_conditions)
+    if frame_state.loop_region_stack:
+        parent_loop = frame_state.loop_region_stack[-1]
+        parent_loop.actions.append(op_action)
+        parent_loop.body_sequence.append(("action", len(parent_loop.actions) - 1))
+    else:
+        parent_kernel = frame_state.kernel_region_stack[-1]
+        parent_kernel.actions.append(op_action)
+        parent_kernel.body_sequence.append(("action", len(parent_kernel.actions) - 1))
+
+
+def push_active_condition(predicate: Any) -> Any:
+    frame_state = get_simulator_frame_state()
+    resolved_predicate = _resolve_simulator_capture_value(predicate)
+    frame_state.active_conditions.append(resolved_predicate)
+    return resolved_predicate
+
+
+def pop_active_condition(predicate: Any) -> None:
+    frame_state = get_simulator_frame_state()
+    if not frame_state.active_conditions:
+        raise RuntimeError("Cannot pop active condition: the active-condition stack is empty.")
+    if frame_state.active_conditions[-1] is not predicate:
+        raise RuntimeError("Active condition cleanup must follow strict LIFO order.")
+    frame_state.active_conditions.pop()
+
+
+def make_tensor_access(
+    buffer_like,
+    *,
+    access_mode: str,
+    extents: tuple[Any, ...] | list[Any] | None = None,
+    attrs: dict[str, Any] | None = None,
+) -> TensorAccess:
+    """Normalize a Buffer / BufferRegion / BufferLoad into a simulator TensorAccess.
+
+    The returned record stores:
+    - the accessed tensor symbol name
+    - the per-axis start expressions of the accessed window
+    - the slice extents / strides when available
+    - a best-effort byte count for static slices
+    """
+    from tilelang.language.frame import get_let_value, has_let_value
+    from tilelang.language.proxy import DeferredTensorRegion
+    from tilelang.utils.language import get_buffer_region_from_load
+
+    if isinstance(buffer_like, tir.Var) and has_let_value(buffer_like):
+        buffer_like = get_let_value(buffer_like)
+
+    tensor_name: str | None = None
+    analysis_region = _resolve_simulator_capture_value(buffer_like)
+    if isinstance(buffer_like, DeferredTensorRegion):
+        tensor_name = buffer_like.tensor_name
+        analysis_region = _resolve_simulator_capture_value(buffer_like.region)
+    normalized_extents = None if extents is None else tuple(_resolve_simulator_capture_value(axis_extent) for axis_extent in extents)
+
+    if isinstance(analysis_region, tir.Buffer):
+        buffer = analysis_region
+        region = tir.BufferRegion(
+            buffer,
+            [ir.Range.from_min_extent(tir.IntImm("int32", 0), axis_extent) for axis_extent in buffer.shape],
+        )
+        slice_shape = tuple(_resolve_simulator_capture_value(axis_extent) for axis_extent in buffer.shape)
+    elif isinstance(analysis_region, tir.BufferRegion):
+        buffer = analysis_region.buffer
+        region = analysis_region
+        if normalized_extents is not None:
+            region = tir.BufferRegion(
+                buffer,
+                [
+                    ir.Range.from_min_extent(
+                        _resolve_simulator_capture_value(axis_range.min),
+                        axis_extent,
+                    )
+                    for axis_range, axis_extent in zip(region.region, normalized_extents)
+                ],
+            )
+        slice_shape = tuple(_resolve_simulator_capture_value(axis_range.extent) for axis_range in region.region)
+    elif isinstance(analysis_region, tir.BufferLoad):
+        buffer = analysis_region.buffer
+        if normalized_extents is None:
+            region = get_buffer_region_from_load(analysis_region)
+            if region is None:
+                region = tir.BufferRegion(
+                    buffer,
+                    [
+                        ir.Range.from_min_extent(
+                            _resolve_simulator_capture_value(index_expr),
+                            tir.IntImm("int32", 1),
+                        )
+                        for index_expr in analysis_region.indices
+                    ],
+                )
+        else:
+            region = tir.BufferRegion(
+                buffer,
+                [
+                    ir.Range.from_min_extent(
+                        _resolve_simulator_capture_value(index_expr),
+                        axis_extent,
+                    )
+                    for index_expr, axis_extent in zip(analysis_region.indices, normalized_extents)
+                ],
+            )
+        slice_shape = tuple(_resolve_simulator_capture_value(axis_range.extent) for axis_range in region.region)
+    else:
+        raise TypeError(f"Unsupported simulator tensor access object: {type(buffer_like)}")
+
+    if tensor_name is None:
+        tensor_name = getattr(buffer, "name", None) or getattr(buffer.data, "name", None) or str(buffer)
+
+    buffer_strides = tuple(_resolve_simulator_capture_value(stride) for stride in buffer.strides) if buffer.strides is not None else None
+    if buffer_strides is None:
+        running_stride = 1
+        inferred_strides = []
+        for axis_extent in reversed(buffer.shape):
+            inferred_strides.insert(0, running_stride)
+            running_stride *= axis_extent
+        buffer_strides = tuple(inferred_strides)
+    if len(buffer_strides) != len(slice_shape):
+        buffer_strides = None
+
+    byte_count = None
+    try:
+        dtype = DataType(buffer.dtype)
+        element_size = dtype.bits // 8
+        byte_count = element_size
+        for axis_extent in slice_shape:
+            if not isinstance(axis_extent, int):
+                byte_count = None
+                break
+            byte_count *= axis_extent
+    except Exception:  # pylint: disable=broad-except
+        byte_count = None
+
+    tensor_attrs = dict(attrs or {})
+    tensor_attrs.setdefault("scope", buffer.scope())
+    tensor_attrs.setdefault("dtype", buffer.dtype)
+
+    return TensorAccess(
+        tensor_name=tensor_name,
+        access_mode=access_mode,
+        index_expressions=tuple(_resolve_simulator_capture_value(axis_range.min) for axis_range in region.region),
+        slice_shape=slice_shape,
+        slice_strides=buffer_strides,
+        byte_count=byte_count,
+        attrs=_resolve_simulator_capture_value(tensor_attrs),
+    )
+
+
+def record_parameter_tensor_reference(name: str, access_keys: tuple[Any, ...]) -> int:
+    frame_state = get_simulator_frame_state()
+    tensor_declaration = frame_state.tensor_declarations.get(name)
+    if tensor_declaration is None or not tensor_declaration.from_parameter:
+        raise ValueError(f"Tensor `{name}` is not a registered prim-func parameter.")
+    access_id = frame_state.next_tensor_access_id
+    frame_state.next_tensor_access_id += 1
+    pending_references = tensor_declaration.attrs.setdefault("pending_references", [])
+    pending_references.append(
+        {
+            "access_id": access_id,
+            "access_keys": tuple(access_keys),
+            "expected_shape": None,
+        }
+    )
+    return access_id
+
+
+def update_parameter_tensor_reference_shape(name: str, access_id: int, expected_shape: tuple[Any, ...]) -> None:
+    tensor_declaration = get_tensor_declaration(name)
+    if tensor_declaration is None:
+        return
+    pending_references = tensor_declaration.attrs.get("pending_references", [])
+    for pending_reference in pending_references:
+        if pending_reference["access_id"] == access_id:
+            pending_reference["expected_shape"] = tuple(expected_shape)
+            return
+
+
+def _ensure_within_bounds(index_value, extent, description: str) -> None:
+    analyzer = arith.Analyzer()
+    zero = tir.IntImm("int32", 0)
+    if isinstance(index_value, int) and isinstance(extent, int):
+        if index_value < 0 or index_value >= extent:
+            raise ValueError(f"{description} is out of bounds for extent {extent}.")
+        return
+    if isinstance(index_value, tir.IntImm):
+        if index_value.value < 0:
+            raise ValueError(f"{description} is out of bounds for extent {extent}.")
+        if isinstance(extent, tir.IntImm) and index_value.value >= extent.value:
+            raise ValueError(f"{description} is out of bounds for extent {extent.value}.")
+    if analyzer.can_prove(index_value < zero):
+        raise ValueError(f"{description} is out of bounds for extent {extent}.")
+    if analyzer.can_prove(index_value >= extent):
+        raise ValueError(f"{description} is out of bounds for extent {extent}.")
+
+
+def _compute_slice_extent(start, stop, step):
+    if isinstance(start, int) and isinstance(stop, int) and isinstance(step, int):
+        if step <= 0:
+            raise ValueError("Negative or zero slice steps are not supported for deferred tensor validation.")
+        return max(0, math.ceil((stop - start) / step))
+    if isinstance(step, tir.IntImm) and step.value <= 0:
+        raise ValueError("Negative or zero slice steps are not supported for deferred tensor validation.")
+    return tir.ceildiv(stop - start, step)
+
+
+# ---------------------------------------------------------------------------
+# Deferred parameter tensor validation
+# ---------------------------------------------------------------------------
+
+def _compute_access_shape(access_keys: tuple[Any, ...], declared_shape: tuple[Any, ...]) -> tuple[Any, ...]:
+    if len(access_keys) > len(declared_shape):
+        raise ValueError(
+            f"Deferred tensor access rank {len(access_keys)} exceeds declared tensor rank {len(declared_shape)}."
+        )
+    access_shape = []
+    for axis, key in enumerate(access_keys):
+        axis_extent = declared_shape[axis]
+        if isinstance(key, slice):
+            start = tir.IntImm("int32", 0) if key.start is None else key.start
+            stop = axis_extent if key.stop is None else key.stop
+            step = tir.IntImm("int32", 1) if key.step is None else key.step
+            _ensure_within_bounds(start, axis_extent, f"Slice start on axis {axis}")
+            if isinstance(stop, int):
+                if stop < 0:
+                    raise ValueError(f"Slice stop on axis {axis} is out of bounds for extent {axis_extent}.")
+                if isinstance(axis_extent, int) and stop > axis_extent:
+                    raise ValueError(f"Slice stop on axis {axis} is out of bounds for extent {axis_extent}.")
+            elif isinstance(stop, tir.IntImm):
+                if stop.value < 0:
+                    raise ValueError(f"Slice stop on axis {axis} is out of bounds for extent {axis_extent}.")
+            elif arith.Analyzer().can_prove(stop > axis_extent):
+                raise ValueError(f"Slice stop on axis {axis} is out of bounds for extent {axis_extent}.")
+            access_shape.append(_compute_slice_extent(start, stop, step))
+        else:
+            normalized_key = key
+            if isinstance(key, int) and key < 0 and isinstance(axis_extent, int):
+                normalized_key = axis_extent + key
+            elif isinstance(key, tir.IntImm) and key.value < 0 and isinstance(axis_extent, tir.IntImm):
+                normalized_key = tir.IntImm(key.dtype, axis_extent.value + key.value)
+            _ensure_within_bounds(normalized_key, axis_extent, f"Index on axis {axis}")
+    return tuple(access_shape)
+
+
+def _validate_pending_tensor_references(tensor_declaration: TensorDecl) -> None:
+    pending_references = tensor_declaration.attrs.get("pending_references", [])
+    if not pending_references:
+        return
+    if tensor_declaration.shape is None:
+        raise ValueError(f"Tensor `{tensor_declaration.name}` must declare shape before deferred references can be validated.")
+    analyzer = arith.Analyzer()
+
+    def _to_extent_expr(extent_value: Any):
+        if isinstance(extent_value, int):
+            return tir.IntImm("int32", extent_value)
+        return extent_value
+
+    for pending_reference in pending_references:
+        actual_access_shape = _compute_access_shape(pending_reference["access_keys"], tensor_declaration.shape)
+        expected_shape = pending_reference.get("expected_shape")
+        if expected_shape is None:
+            continue
+        if len(actual_access_shape) != len(expected_shape):
+            raise ValueError(
+                f"Deferred tensor access on `{tensor_declaration.name}` has rank {len(actual_access_shape)}, "
+                f"but later use expects rank {len(expected_shape)}."
+            )
+        for actual_extent, expected_extent in zip(actual_access_shape, expected_shape):
+            if isinstance(actual_extent, int) and isinstance(expected_extent, int):
+                if actual_extent != expected_extent:
+                    raise ValueError(
+                        f"Deferred tensor access on `{tensor_declaration.name}` expected extent {expected_extent}, got {actual_extent}."
+                    )
+                continue
+            if isinstance(actual_extent, tir.IntImm) and isinstance(expected_extent, tir.IntImm):
+                if actual_extent.value != expected_extent.value:
+                    raise ValueError(
+                        f"Deferred tensor access on `{tensor_declaration.name}` expected extent {expected_extent.value}, got {actual_extent.value}."
+                    )
+                continue
+            actual_extent_expr = _to_extent_expr(actual_extent)
+            expected_extent_expr = _to_extent_expr(expected_extent)
+            if tir.analysis.expr_deep_equal(actual_extent_expr, expected_extent_expr):
+                continue
+            if analyzer.can_prove(actual_extent_expr == expected_extent_expr):
+                continue
+            simplified_difference = analyzer.simplify(actual_extent_expr - expected_extent_expr)
+            if isinstance(simplified_difference, tir.IntImm) and simplified_difference.value == 0:
+                continue
+            if not analyzer.can_prove(actual_extent_expr != expected_extent_expr):
+                continue
+            if not tir.analysis.expr_deep_equal(actual_extent, expected_extent):
+                raise ValueError(
+                    f"Deferred tensor access on `{tensor_declaration.name}` expected extent {expected_extent}, got {actual_extent}."
+                )
+
+
+def record_parameter_tensor_definition(name: str, tensor_buffer) -> TensorDecl:
+    frame_state = get_simulator_frame_state()
+    tensor_declaration = frame_state.tensor_declarations.get(name)
+    if tensor_declaration is None or not tensor_declaration.from_parameter:
+        raise ValueError(f"Tensor `{name}` is not a registered prim-func parameter.")
+    if tensor_declaration.has_layout:
+        raise ValueError(f"Tensor `{name}` already has a shape/strides definition.")
+    tensor_declaration.shape = tuple(tensor_buffer.shape)
+    tensor_declaration.strides = None if tensor_buffer.strides is None else tuple(tensor_buffer.strides)
+    tensor_declaration.dtype = tensor_buffer.dtype
+    tensor_declaration.attrs["scope"] = tensor_buffer.scope()
+    tensor_declaration.attrs["defined_in_body"] = True
+    _validate_pending_tensor_references(tensor_declaration)
+    for core_array_context in frame_state.core_array_contexts:
+        if tensor_declaration.name not in core_array_context.tensors:
+            core_array_context.register_tensor(tensor_declaration)
+    return tensor_declaration
+
+
+# ---------------------------------------------------------------------------
+# SPMD / MPMD binding derivation
+# ---------------------------------------------------------------------------
+
+def _normalize_identifier(text: str) -> str:
+    normalized_text = re.sub(r"[^0-9A-Za-z_]", "_", text)
+    if not normalized_text:
+        return "core_id"
+    if normalized_text[0].isdigit():
+        return f"core_{normalized_text}"
+    return normalized_text
+
+
+def _normalize_binding_tuple(binding_values: Any, field_name: str, expected_rank: int | None = None) -> tuple[Any, ...]:
+    if isinstance(binding_values, tuple):
+        normalized_binding_values = binding_values
+    elif isinstance(binding_values, list):
+        normalized_binding_values = tuple(binding_values)
+    else:
+        raise TypeError(f"T.SPMD binding field `{field_name}` must be tuple/list-like, but got {type(binding_values)}.")
+    if expected_rank is not None and len(normalized_binding_values) != expected_rank:
+        raise ValueError(f"T.SPMD binding field `{field_name}` must have rank {expected_rank}, but got {len(normalized_binding_values)}.")
+    return normalized_binding_values
+
+
+def _normalize_core_axis_mapping(mapped_core_axes: Any, core_array_rank: int) -> tuple[int, ...] | None:
+    if mapped_core_axes is None:
+        return None
+    if isinstance(mapped_core_axes, int):
+        normalized_core_axes = (mapped_core_axes,)
+    elif isinstance(mapped_core_axes, list):
+        normalized_core_axes = tuple(mapped_core_axes)
+    elif isinstance(mapped_core_axes, tuple):
+        normalized_core_axes = mapped_core_axes
+    else:
+        raise TypeError(f"T.SPMD core_dim_mapping entries must be int, tuple/list-like, or None, but got {type(mapped_core_axes)}.")
+    if not normalized_core_axes:
+        raise ValueError("T.SPMD core_dim_mapping entries cannot be empty tuples.")
+    normalized_core_axis_list = []
+    for core_axis in normalized_core_axes:
+        if not isinstance(core_axis, int):
+            raise TypeError(f"T.SPMD core_dim_mapping axis values must be integers, but got {type(core_axis)}.")
+        if core_axis < 0 or core_axis >= core_array_rank:
+            raise ValueError(
+                f"T.SPMD core_dim_mapping axis {core_axis} is out of range for CoreArray rank {core_array_rank}."
+            )
+        normalized_core_axis_list.append(core_axis)
+    return tuple(normalized_core_axis_list)
+
+
+def _derive_gemm_bindings(region_kwargs: dict[str, Any], core_array_shape: tuple[int, ...]) -> tuple[Any, ...]:
+    gemm_shape = _normalize_binding_tuple(region_kwargs.get("gemm_shape"), "gemm_shape", expected_rank=3)
+    core_dim_mapping = region_kwargs.get("core_dim_mapping", (None, None, None))
+    normalized_core_dim_mapping = _normalize_binding_tuple(core_dim_mapping, "core_dim_mapping", expected_rank=3)
+    core_array_rank = len(core_array_shape)
+    per_core_dimensions = []
+    for base_extent, mapped_core_axes in zip(gemm_shape, normalized_core_dim_mapping):
+        normalized_core_axes = _normalize_core_axis_mapping(mapped_core_axes, core_array_rank)
+        if normalized_core_axes is None:
+            per_core_dimensions.append(base_extent)
+            continue
+        split_factor = 1
+        for core_axis in normalized_core_axes:
+            split_factor *= core_array_shape[core_axis]
+        if isinstance(base_extent, int):
+            per_core_dimensions.append(math.ceil(base_extent / split_factor))
+        else:
+            per_core_dimensions.append(tir.ceildiv(base_extent, split_factor))
+    return tuple(per_core_dimensions)
+
+
+def _derive_spmd_bindings(operator_category: str, region_kwargs: dict[str, Any], core_array_shape: tuple[int, ...]) -> tuple[Any, ...] | None:
+    if operator_category == "gemm":
+        return _derive_gemm_bindings(region_kwargs, core_array_shape)
+    if operator_category == "decode-attention":
+        return _normalize_binding_tuple(region_kwargs.get("attention_shape"), "attention_shape", expected_rank=5)
+    if operator_category == "general":
+        return None
+    for field_name in ("binding_shape", "region_shape", "shape"):
+        binding_values = region_kwargs.get(field_name)
+        if binding_values is None:
+            continue
+        return _normalize_binding_tuple(binding_values, field_name)
+    raise ValueError(
+        "T.SPMD currently requires one of binding_shape/region_shape/shape, "
+        "or a recognized operator category with corresponding shape kwargs."
+    )
+
+
+# ---------------------------------------------------------------------------
+# General region validation
+# ---------------------------------------------------------------------------
+
+def _ensure_general_region_has_no_kwargs(frame_name: str, region_kwargs: dict[str, Any]) -> None:
+    if not region_kwargs:
+        return
+    extra_fields = ", ".join(sorted(region_kwargs))
+    raise ValueError(f"{frame_name}(type=\"general\") only accepts `name` and `type`, but got extra kwargs: {extra_fields}.")
+
+
+def _validate_general_spmd_region(op_region: OpRegion) -> None:
+    kernel_count = len(op_region.kernel_regions)
+    if kernel_count != 1:
+        raise ValueError(f"T.SPMD(..., type=\"general\") requires exactly one T.Kernel region, but got {kernel_count}.")
+    kernel_region = op_region.kernel_regions[0]
+    if kernel_region.core_list is not None:
+        raise ValueError(
+            "T.SPMD(..., type=\"general\") does not accept T.Kernel(core_list=...). "
+            "Use T.MPMD(..., type=\"general\") for per-core kernel placement."
+        )
+
+
+def _validate_general_mpmd_region(op_region: OpRegion, core_num: int) -> None:
+    assigned_core_to_kernel: dict[int, int] = {}
+    for kernel_index, kernel_region in enumerate(op_region.kernel_regions):
+        core_list = kernel_region.core_list
+        if core_list is None:
+            raise ValueError(
+                f"T.MPMD(..., type=\"general\") requires every T.Kernel to provide core_list; "
+                f"kernel {kernel_index} has no core_list."
+            )
+        if not core_list:
+            raise ValueError(
+                f"T.MPMD(..., type=\"general\") requires every T.Kernel core_list to be non-empty; "
+                f"kernel {kernel_index} has an empty core_list."
+            )
+
+        local_cores: set[int] = set()
+        for core_id in core_list:
+            if type(core_id) is not int:
+                raise TypeError(
+                    f"T.MPMD(..., type=\"general\") core_list entries must be static int values; "
+                    f"kernel {kernel_index} got {core_id!r} ({type(core_id).__name__})."
+                )
+            if core_id < 0 or core_id >= core_num:
+                raise ValueError(
+                    f"T.MPMD(..., type=\"general\") core_id {core_id} in kernel {kernel_index} "
+                    f"is out of range for CoreArray core_num {core_num}."
+                )
+            if core_id in local_cores:
+                raise ValueError(
+                    f"T.MPMD(..., type=\"general\") core_id {core_id} appears more than once "
+                    f"in kernel {kernel_index} core_list."
+                )
+            if core_id in assigned_core_to_kernel:
+                raise ValueError(
+                    f"T.MPMD(..., type=\"general\") core_id {core_id} appears in both kernel "
+                    f"{assigned_core_to_kernel[core_id]} and kernel {kernel_index}."
+                )
+            local_cores.add(core_id)
+            assigned_core_to_kernel[core_id] = kernel_index
+
+
+# ---------------------------------------------------------------------------
+# User-facing frame wrappers
+# ---------------------------------------------------------------------------
+
+class CoreArray:
+    def __init__(self, shape: tuple[int, ...], **kwargs: Any):
+        self.core_array_shape = tuple(shape)
+        self.global_kwargs = dict(kwargs)
+        self.core_array_context: CoreArrayContext | None = None
+
+    def __enter__(self):
+        frame_state = get_simulator_frame_state()
+        self.core_array_context = CoreArrayContext(
+            core_array_shape=self.core_array_shape,
+            global_kwargs=self.global_kwargs,
+        )
+        frame_state.core_array_contexts.append(self.core_array_context)
+        for tensor_declaration in frame_state.tensor_declarations.values():
+            self.core_array_context.register_tensor(tensor_declaration)
+        frame_state.core_array_stack.append(self.core_array_context)
+        return None
+
+    def __exit__(self, exc_type, exc_value, traceback):
+        frame_state = get_simulator_frame_state()
+        if frame_state.core_array_stack and frame_state.core_array_stack[-1] is self.core_array_context:
+            frame_state.core_array_stack.pop()
+        return False
+
+
+class SPMD:
+    def __init__(self, name: str, type: str, **kwargs: Any):
+        self.region_name = name
+        self.operator_category = type
+        self.region_kwargs = dict(kwargs)
+        self.op_region: OpRegion | None = None
+
+    def __enter__(self):
+        frame_state = get_simulator_frame_state()
+        if not frame_state.core_array_stack:
+            raise RuntimeError("T.SPMD must be used inside T.CoreArray.")
+        if self.operator_category == "general":
+            _ensure_general_region_has_no_kwargs("T.SPMD", self.region_kwargs)
+        current_core_array_context = frame_state.core_array_stack[-1]
+        self.op_region = OpRegion(
+            name=self.region_name,
+            region_kind="spmd",
+            op_category=self.operator_category,
+            region_kwargs=self.region_kwargs,
+        )
+        current_core_array_context.register_op_region(self.op_region)
+        frame_state.op_region_stack.append(self.op_region)
+        bound_values = _derive_spmd_bindings(
+            self.operator_category,
+            self.region_kwargs,
+            current_core_array_context.core_array_shape,
+        )
+        self.op_region.attrs["bound_values"] = bound_values
+        return bound_values
+
+    def __exit__(self, exc_type, exc_value, traceback):
+        frame_state = get_simulator_frame_state()
+        if frame_state.op_region_stack and frame_state.op_region_stack[-1] is self.op_region:
+            frame_state.op_region_stack.pop()
+        if exc_type is None and self.op_region is not None and self.operator_category == "general":
+            _validate_general_spmd_region(self.op_region)
+        return False
+
+
+class MPMD:
+    def __init__(self, name: str, type: str, **kwargs: Any):
+        self.region_name = name
+        self.operator_category = type
+        self.region_kwargs = dict(kwargs)
+        self.op_region: OpRegion | None = None
+        self.core_identifier = tir.Var(f"{_normalize_identifier(name)}_core_id", "int32")
+        self.core_num: int | None = None
+
+    def __enter__(self):
+        frame_state = get_simulator_frame_state()
+        if not frame_state.core_array_stack:
+            raise RuntimeError("T.MPMD must be used inside T.CoreArray.")
+        if self.operator_category == "general":
+            _ensure_general_region_has_no_kwargs("T.MPMD", self.region_kwargs)
+        current_core_array_context = frame_state.core_array_stack[-1]
+        self.core_num = current_core_array_context.core_num
+        self.op_region = OpRegion(
+            name=self.region_name,
+            region_kind="mpmd",
+            op_category=self.operator_category,
+            region_kwargs=self.region_kwargs,
+        )
+        current_core_array_context.register_op_region(self.op_region)
+        frame_state.op_region_stack.append(self.op_region)
+        self.op_region.attrs["core_identifier"] = self.core_identifier.name
+        return self.core_identifier
+
+    def __exit__(self, exc_type, exc_value, traceback):
+        frame_state = get_simulator_frame_state()
+        if frame_state.op_region_stack and frame_state.op_region_stack[-1] is self.op_region:
+            frame_state.op_region_stack.pop()
+        if exc_type is None and self.op_region is not None and self.operator_category == "general":
+            if self.core_num is None:
+                raise RuntimeError("T.MPMD general validation requires an active CoreArray core count.")
+            _validate_general_mpmd_region(self.op_region, self.core_num)
+        return False
+
+
+class SimulatorKernelFrame:
+    def __init__(
+        self,
+        kernel_launch_frame,
+        block_expressions: tuple[Any, ...],
+        thread_expressions: tuple[Any, ...] | None,
+        autotune_enabled: bool | None,
+        core_list: list[int] | None,
+        attrs: dict[str, Any],
+    ):
+        self.kernel_launch_frame = kernel_launch_frame
+        self.block_expressions = tuple(block_expressions)
+        self.thread_expressions = None if thread_expressions is None else tuple(thread_expressions)
+        self.autotune_enabled = autotune_enabled
+        self.core_list = None if core_list is None else list(core_list)
+        self.attrs = dict(attrs)
+        self.kernel_region: KernelRegion | None = None
+
+    def __enter__(self):
+        bound_values = self.kernel_launch_frame.__enter__()
+        frame_state = get_simulator_frame_state()
+        if frame_state.op_region_stack:
+            kernel_attrs = dict(self.attrs)
+            block_ceildivs = []
+            for block_index, block_expression in enumerate(self.block_expressions):
+                metadata = frame_state.ceildiv_expression_metadata.get(id(block_expression))
+                if metadata is not None:
+                    block_ceildivs.append(
+                        {
+                            "block_index": block_index,
+                            "lhs": metadata["lhs"],
+                            "rhs": metadata["rhs"],
+                        }
+                    )
+            if block_ceildivs:
+                kernel_attrs["block_ceildivs"] = block_ceildivs
+            self.kernel_region = KernelRegion(
+                block_expressions=self.block_expressions,
+                thread_expressions=self.thread_expressions,
+                autotune_enabled=self.autotune_enabled,
+                core_list=self.core_list,
+                bound_symbols=(
+                    (bound_values.name,) if isinstance(bound_values, tir.Var) else
+                    tuple(value.name for value in bound_values if isinstance(value, tir.Var))
+                    if isinstance(bound_values, (list, tuple))
+                    else tuple()
+                ),
+                attrs=kernel_attrs,
+            )
+            frame_state.op_region_stack[-1].kernel_regions.append(self.kernel_region)
+            frame_state.kernel_region_stack.append(self.kernel_region)
+        return bound_values
+
+    def __exit__(self, exc_type, exc_value, traceback):
+        frame_state = get_simulator_frame_state()
+        if frame_state.kernel_region_stack and frame_state.kernel_region_stack[-1] is self.kernel_region:
+            frame_state.kernel_region_stack.pop()
+        return self.kernel_launch_frame.__exit__(exc_type, exc_value, traceback)
+
+
+def wrap_kernel_launch_frame(
+    kernel_launch_frame,
+    *,
+    block_expressions: tuple[Any, ...],
+    thread_expressions: tuple[Any, ...] | None,
+    autotune_enabled: bool | None,
+    core_list: list[int] | None,
+    attrs: dict[str, Any],
+):
+    frame_state = get_simulator_frame_state()
+    if not frame_state.op_region_stack:
+        return kernel_launch_frame
+    return SimulatorKernelFrame(
+        kernel_launch_frame,
+        block_expressions=block_expressions,
+        thread_expressions=thread_expressions,
+        autotune_enabled=autotune_enabled,
+        core_list=core_list,
+        attrs=attrs,
+    )
