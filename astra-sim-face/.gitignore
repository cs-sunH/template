# astra-sim-face 裸仓库 ignore 约定（2026-09-29 新建）：README §2⑥ 与
# sh_test_mesh/run_scripts/clean_test_records.sh、clean_build_artifacts.sh
# 均以"产物不入 git / gitignored by design"为前提（README §4 亦明示
# sh_test_mesh/generated/ gitignored by design），此前本仓一直缺本文件。
# ignore 范围与上述清理脚本的删除口径一一对应。

# —— 编译产物（clean_build_artifacts.sh；clean_test_records.sh --full 同口径）——
/build/
/build_congestion_aware/

# —— 物化数据与运行产物（clean_test_records.sh 第 1 节）——
/sh_test_mesh/generated/
/sh_test_mesh/results/
/sh_test_mesh/run_logs/
/sh_test_mesh/log/
/log/

# completion_fixture 等测试再生目录（clean_test_records.sh 第 2 节：仓内
# 任意深度）
**/completion_fixture/

# —— traces/ 物化数据（clean_test_records.sh 第 3 节：仅保留 *.py 物化器
# 脚本；物化产物 CSV/sidecar 等数据件不入 git。注意不得用 *.py 排除类
# 规则误伤物化器脚本）——
/sh_test_mesh/workload/llama2_7b_inference/traces/*
!/sh_test_mesh/workload/llama2_7b_inference/traces/*.py

# —— Python 缓存（clean_test_records.sh 第 5 节）——
__pycache__/
*.py[cod]
.pytest_cache/
